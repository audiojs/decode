{
  "name": "@audio/decode",
  "version": "4.3.0",
  "description": "Decode audio data in node or browser",
  "type": "module",
  "sideEffects": false,
  "main": "audio-decode.js",
  "types": "audio-decode.d.ts",
  "files": [
    "audio-decode.js",
    "audio-decode.d.ts",
    "stream.js",
    "stream.d.ts",
    "meta.js",
    "test.html",
    "members/"
  ],
  "exports": {
    ".": {
      "browser": "./audio-decode.js",
      "node": "./audio-decode.js",
      "default": "./audio-decode.js"
    },
    "./stream": "./stream.js",
    "./meta": "./meta.js",
    "./package.json": "./package.json",
    "./*": {
      "types": "./members/*.d.ts",
      "default": "./members/*.js"
    }
  },
  "workspaces": [
    "packages/*"
  ],
  "dependencies": {
    "@audio/decode-aac": "^1.6.0",
    "@audio/decode-ac3": "^1.0.0",
    "@audio/decode-aiff": "^1.3.1",
    "@audio/decode-amr": "^1.3.1",
    "@audio/decode-ape": "^1.0.0",
    "@audio/decode-gsm": "^0.1.0",
    "@audio/decode-avi": "^1.1.0",
    "@audio/decode-caf": "^1.4.2",
    "@audio/decode-dts": "^1.0.0",
    "@audio/decode-flac": "^2.0.0",
    "@audio/decode-mp3": "^1.3.1",
    "@audio/decode-mp4": "^1.3.1",
    "@audio/decode-opus": "^1.3.3",
    "@audio/decode-qoa": "^2.0.0",
    "@audio/decode-vorbis": "^1.3.4",
    "@audio/decode-wav": "^2.0.0",
    "@audio/decode-webm": "^1.6.1",
    "@audio/decode-wma": "^1.4.0",
    "audio-type": "^2.8.0",
    "@audio/decode-wavpack": "^2.0.0",
    "@audio/decode-tta": "^2.0.0",
    "@audio/decode-mpc": "^1.0.0",
    "@audio/decode-mod": "^1.0.0",
    "@audio/decode-dsd": "^1.0.0"
  },
  "devDependencies": {
    "audio-lena": "^3.0.0",
    "base64-arraybuffer": "^1.0.2",
    "esbuild": "^0.28.0",
    "playwright": "^1.58.0",
    "tst": "^9.2.2"
  },
  "scripts": {
    "test": "node test.js",
    "test:browser": "node test.browser.js",
    "test:all": "node test.js && node test.browser.js",
    "publish:all": "for d in packages/* .; do [ -f \"$d/package.json\" ] || continue; id=$(node -p \"require('./'+'$d'+'/package.json').name+'@'+require('./'+'$d'+'/package.json').version\"); npm view \"$id\" version >/dev/null 2>&1 && echo \"skip $id\" || (cd \"$d\" && npm publish); done",
    "members": "node scripts/members.js",
    "prepublishOnly": "node scripts/members.js --check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/decode.git"
  },
  "keywords": [
    "audio",
    "decode",
    "decoder",
    "codec",
    "mp3",
    "wav",
    "ogg",
    "vorbis",
    "opus",
    "flac",
    "aac",
    "m4a",
    "qoa",
    "aiff",
    "caf",
    "webm",
    "amr",
    "gsm",
    "wma",
    "pcm",
    "streaming",
    "mp4",
    "mov",
    "mkv",
    "avi",
    "video",
    "extract",
    "ac3",
    "dts"
  ],
  "author": "Dmitry Iv. <dfcreative@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/audiojs/decode/issues"
  },
  "homepage": "https://github.com/audiojs/decode#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "funding": "https://github.com/sponsors/audiojs"
}

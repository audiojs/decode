{
  "name": "@audio/decode-avi",
  "version": "1.1.0",
  "description": "Decode the audio stream of AVI files (PCM, MP3, AAC, \u00b5-law, A-law) to PCM samples",
  "type": "module",
  "main": "decode-avi.js",
  "types": "decode-avi.d.ts",
  "exports": {
    ".": "./decode-avi.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node test.js"
  },
  "files": [
    "decode-avi.js",
    "decode-avi.d.ts",
    "audio.js",
    "audio.d.ts",
    "LICENSE"
  ],
  "dependencies": {
    "@audio/decode-aac": "^1.5.0",
    "@audio/decode-ac3": "^1.0.0",
    "@audio/decode-dts": "^1.0.0",
    "@audio/decode-mp3": "^1.3.0"
  },
  "devDependencies": {
    "tst": "^9.2.2"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "avi",
    "riff",
    "opendml",
    "demux",
    "video",
    "audio",
    "decode",
    "decoder",
    "pcm",
    "mp3",
    "aac"
  ],
  "license": "MIT",
  "author": "audiojs",
  "homepage": "https://github.com/audiojs/decode/tree/main/packages/decode-avi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/decode.git",
    "directory": "packages/decode-avi"
  },
  "bugs": "https://github.com/audiojs/decode/issues",
  "audio": "./audio.js",
  "sideEffects": false,
  "funding": "https://github.com/sponsors/audiojs"
}

{
  "name": "@audio/decode-opus",
  "version": "1.3.1",
  "description": "Decode Ogg Opus audio with local libopus WASM",
  "type": "module",
  "main": "decode-opus.js",
  "types": "decode-opus.d.ts",
  "exports": {
    ".": "./decode-opus.js",
    "./core": {
      "types": "./core.d.ts",
      "default": "./core.js"
    },
    "./meta": "./meta.js",
    "./audio": {
      "types": "./audio.d.ts",
      "default": "./audio.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "decode-opus.js",
    "src/decode-opus.js",
    "core.js",
    "core.d.ts",
    "meta.js",
    "decode-opus.d.ts",
    "src/opus.wasm.js",
    "LICENSE",
    "LICENSE.libopus",
    "audio.js",
    "audio.d.ts"
  ],
  "scripts": {
    "build": "bash build.sh",
    "prepack": "npm run build",
    "test": "node test.js"
  },
  "keywords": [
    "opus",
    "ogg",
    "audio",
    "decode",
    "decoder",
    "wasm"
  ],
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "audiojs",
  "homepage": "https://github.com/audiojs/decode/tree/master/packages/decode-opus#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/audiojs/decode.git",
    "directory": "packages/decode-opus"
  },
  "bugs": "https://github.com/audiojs/decode/issues",
  "dependencies": {
    "codec-parser": "~2.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "audio": "./audio.js",
  "sideEffects": false,
  "funding": "https://github.com/sponsors/audiojs"
}
